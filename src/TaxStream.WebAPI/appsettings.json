{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=taxstream.db"
  },
  "Jwt": {
    "SigningKey": "TaxStream_Default_Dev_Signing_Key_Min_32_Chars_2026!",
    "Issuer": "TaxStream",
    "Audience": "TaxStreamUsers",
    "ExpiryMinutes": 60
  },
  "AzureOpenAI": {
    "Endpoint": "REPLACE_VIA_USER_SECRETS",
    "ApiKey": "REPLACE_VIA_USER_SECRETS",
    "DeploymentName": "gpt-4o",
    "MaxTokens": 800,
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
